# Database (free tier: https://neon.tech or https://supabase.com)
DATABASE_URL="postgresql://postgres:password@localhost:5432/worferankflow"

# Redis (free tier: https://upstash.com)
REDIS_URL="redis://localhost:6379"

# Auth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret-min-32-chars"

# Google OAuth (optional - leave empty to use email-only sign in)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Google Gemini (free tier: https://aistudio.google.com/apikey)
GEMINI_API_KEY="your-gemini-api-key"

# Stripe (optional - leave empty to disable billing)
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_STARTER_PRICE_ID=""
STRIPE_PRO_PRICE_ID=""
STRIPE_ENTERPRISE_PRICE_ID=""

# Email (optional - leave empty to disable email notifications)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="Worfe RankFlow <noreply@worferankflow.com>"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Worfe RankFlow"

# Storage (optional - for image uploads)
S3_BUCKET=""
S3_REGION=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
S3_ENDPOINT=""
